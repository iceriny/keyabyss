}

[resource]
script = ExtResource("1")
id = &"T57"
title = "合订"
description = "选择一本非主书，接入其基础材料并改善该材料的加工保留；不要求先走到对应书根；非独卷配置；共用制作供给，不取得远方天赋与特殊许可，不加第二套主术与终式"
stage = &"M3"
supported = true
rules = Array[ExtResource("2")]([SubResource("Rule")])
