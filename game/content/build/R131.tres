[resource]
script = ExtResource("1")
id = &"R131"
title = "补字羽签"
description = "支持辅助补全；无；按 Ctrl 主动补全，所需制作额度较少；只按手打部分施法；与其他辅助效果共享制作额度，补出字母不算完整手打奖励"
stage = &"M3"
supported = true
rules = Array[ExtResource("2")]([SubResource("Rule")])
permits = PackedStringArray()
