static func diagnose(rule: RuleDefinition) -> String:
	if rule.id == &"" or rule.operation not in OPERATIONS or rule.phase != &"compile":
		return "未登记的原生操作或阶段：%s / %s" % [rule.operation, rule.phase]
	for parameter in rule.parameters:
		if not UNITS.has(parameter) or absi(rule.parameters[parameter]) > 1 << 30:
			return "参数没有单位契约或超出整数范围：%s" % parameter
	return ""
