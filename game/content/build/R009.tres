&"dodge_capacity": 1,
}

[resource]
script = ExtResource("1")
id = &"R009"
title = "折叠书页"
description = "闪避充能恢复时间缩短 {recovery_pct}%，充能上限增加 {capacity}。"
stage = &"M3"
supported = true
