[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://ui/loading_feedback.gd" id="1"]
[ext_resource type="FontFile" path="res://assets/fonts/jinghua-song.ttf" id="2"]

[sub_resource type="StyleBoxFlat" id="Track"]
bg_color = Color(0.45, 0.53, 0.52, 0.12)

[sub_resource type="StyleBoxFlat" id="Fill"]
bg_color = Color(0.75, 0.65, 0.42, 0.7)

[node name="LoadingFeedback" type="VBoxContainer"]
mouse_filter = 2
theme_override_constants/separation = 12
script = ExtResource("1")

[node name="Stage" type="Label" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_fonts/font = ExtResource("2")
theme_override_font_sizes/font_size = 17
theme_override_colors/font_color = Color(0.81, 0.83, 0.75, 1)
text = "正在载入"
horizontal_alignment = 1

[node name="WaitingTimer" type="Timer" parent="."]
wait_time = 1.0
autostart = true

[node name="Progress" type="ProgressBar" parent="."]
custom_minimum_size = Vector2(0, 2)
layout_mode = 2
mouse_filter = 2
theme_override_styles/background = SubResource("Track")
theme_override_styles/fill = SubResource("Fill")
show_percentage = false

[node name="Count" type="Label" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_fonts/font = ExtResource("2")
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(0.58, 0.66, 0.63, 1)
horizontal_alignment = 1

[connection signal="timeout" from="WaitingTimer" to="." method="_refresh_elapsed"]
