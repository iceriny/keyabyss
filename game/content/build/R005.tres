[gd_resource type="Resource" script_class="RelicDefinition" load_steps=4 format=3]

[ext_resource type="Script" path="res://game/content/relic_definition.gd" id="1"]
[ext_resource type="Script" path="res://game/content/rule_definition.gd" id="2"]

[sub_resource type="Resource" id="Rule"]
script = ExtResource("2")
id = &"R005:rule"
operation = &"stats"
phase = &"compile"
parameters = {
&"summon_capacity": 1,
}

[resource]
script = ExtResource("1")
id = &"R005"
title = "折纸使魔"
choice_role = &"mechanism"
description = "纸灵上限增加 {capacity}，游击伤害提高 {damage_pct}%，停笔后多活动 {duration} 秒。"
stage = &"M3"
supported = true
rules = Array[ExtResource("2")]([SubResource("Rule")])
permits = PackedStringArray()
max_stacks = 3
numbers = {&"damage_pct": 25, &"duration": 1}
rule_numbers = {&"capacity": &"summon_capacity"}
stack_values = PackedStringArray("capacity", "damage_pct", "duration")
requires_capabilities = PackedStringArray("spirit")
tags = PackedStringArray("spirit")
preferred_books = PackedStringArray("spirit")
