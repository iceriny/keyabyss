[gd_resource type="Resource" script_class="RelicDefinition" load_steps=4 format=3]

[ext_resource type="Script" path="res://game/content/relic_definition.gd" id="1"]
[ext_resource type="Script" path="res://game/content/rule_definition.gd" id="2"]

[sub_resource type="Resource" id="Rule"]
script = ExtResource("2")
id = &"R048:rule"
operation = &"stats"
phase = &"compile"
parameters = {
&"summon_capacity": 3,
}

[resource]
script = ExtResource("1")
id = &"R048"
title = "千纸军团"
description = "纸灵上限增加 {capacity}，交叉斩伤害提高 {cross_pct}%。"
stage = &"M3"
supported = true
rules = Array[ExtResource("2")]([SubResource("Rule")])
permits = PackedStringArray()
max_stacks = 1
allowed_books = PackedStringArray("spirit")
requires_all = PackedStringArray("R005", "R035")
numbers = {&"cross_pct": 100}
rule_numbers = {&"capacity": &"summon_capacity"}
stack_values = PackedStringArray()
tags = PackedStringArray("spirit", "cross")
rarity = &"awakening"
exclusive_group = &"spirit_awakening"
required_stacks = {&"R005": 2, &"R035": 1}
