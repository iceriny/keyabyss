[gd_resource type="Resource" script_class="TalentDefinition" load_steps=4 format=3]

[ext_resource type="Script" path="res://game/content/talent_definition.gd" id="1"]
[ext_resource type="Script" path="res://game/content/rule_definition.gd" id="2"]

[sub_resource type="Resource" id="Rule"]
script = ExtResource("2")
id = &"T16:rule"
operation = &"near-hop"
phase = &"compile"
parameters = {
&"hop_range_q": -205,
&"chain_targets": 2,
}

[resource]
script = ExtResource("1")
id = &"T16"
title = "近织"
description = "缩短单次传递距离，让同一份额分向更多近处目标；已有传递方式；分散敌人时容易断路"
stage = &"M3"
supported = true
rules = Array[ExtResource("2")]([SubResource("Rule")])
